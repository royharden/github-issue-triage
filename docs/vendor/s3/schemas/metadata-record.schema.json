{
  "$defs": {
    "CallContext": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Authority Id",
          "type": "string"
        },
        "child_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Child Id",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "consumer_context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Consumer Context Sha256",
          "type": "string"
        },
        "consumer_namespace": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Consumer Namespace",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Operation Id",
          "type": "string"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "purpose": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Purpose",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_generation": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Generation"
        },
        "span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Span Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Task Id",
          "type": "string"
        },
        "template_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "run_id",
        "operation_id",
        "child_id",
        "task_id",
        "span_id",
        "consumer_namespace",
        "purpose",
        "consumer_context_sha256",
        "policy_sha256",
        "template_sha256",
        "config_sha256"
      ],
      "title": "CallContext",
      "type": "object"
    },
    "MetadataUsage": {
      "additionalProperties": false,
      "description": "An allowlisted numeric usage subtree; no HTTP/body/error payload fields.",
      "properties": {
        "cache_creation_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Creation Input Tokens"
        },
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Input Tokens"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "MetadataUsage",
      "type": "object"
    },
    "NormalizedUsage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Input Tokens"
        },
        "cache_write_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Output Tokens"
        }
      },
      "title": "NormalizedUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/CallContext"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "auth",
            "missing_key",
            "unsupported_capability",
            "invalid_output",
            "price_unknown",
            "budget_rejected",
            "attempt_limit",
            "deadline",
            "cache_miss",
            "unknown_dispatch",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "request_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Identity Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "ok",
        "refused",
        "invalid_output",
        "provider_error",
        "unknown",
        "budget_rejected",
        "unsupported",
        "cache_miss",
        "deadline_exceeded",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetadataUsage"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage_projection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Usage Projection Sha256",
      "type": "string"
    },
    "usage_redacted_fields": {
      "title": "Usage Redacted Fields",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "context",
    "request_identity_sha256",
    "usage",
    "usage_projection_sha256",
    "usage_redacted_fields",
    "status",
    "duration_ms"
  ],
  "title": "MetadataRecord",
  "type": "object"
}
