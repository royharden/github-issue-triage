{
  "$defs": {
    "ChoiceAnswer": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxProperties": 255,
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1
          },
          "title": "Probabilities",
          "type": "object"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "choice",
        "probabilities",
        "confidence"
      ],
      "title": "ChoiceAnswer",
      "type": "object"
    },
    "NoulAnswer": {
      "additionalProperties": false,
      "properties": {
        "noul": {
          "maximum": 1,
          "minimum": 0,
          "title": "Noul",
          "type": "number"
        },
        "type": {
          "const": "noul",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "noul"
      ],
      "title": "NoulAnswer",
      "type": "object"
    },
    "ScoreAnswer": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "legend": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 10,
          "minProperties": 2,
          "title": "Legend",
          "type": "object"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxProperties": 10,
          "minProperties": 2,
          "title": "Probabilities",
          "type": "object"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "type": {
          "const": "score",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "score",
        "legend",
        "probabilities",
        "confidence"
      ],
      "title": "ScoreAnswer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answers": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "choice": "#/$defs/ChoiceAnswer",
            "noul": "#/$defs/NoulAnswer",
            "score": "#/$defs/ScoreAnswer"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ChoiceAnswer"
          },
          {
            "$ref": "#/$defs/NoulAnswer"
          },
          {
            "$ref": "#/$defs/ScoreAnswer"
          }
        ]
      },
      "maxProperties": 256,
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 255,
        "minLength": 1
      },
      "title": "Answers",
      "type": "object"
    },
    "model_reported": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Model Reported",
      "type": "string"
    },
    "question_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Question Spec Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "model_reported",
    "question_spec_sha256",
    "answers"
  ],
  "title": "TypedJudgmentResult",
  "type": "object"
}
