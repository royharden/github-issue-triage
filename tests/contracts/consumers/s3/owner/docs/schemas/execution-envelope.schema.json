    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "request",
    "provider_config_sha256",
    "purpose",
    "ledger_ref",
    "budget",
    "context",
    "limits",
    "allocation",
    "capture_mode"
