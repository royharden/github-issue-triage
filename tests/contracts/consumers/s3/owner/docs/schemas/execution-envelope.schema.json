{
  "$defs": {
    "Allocation": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Allocation Id",
          "type": "string"
        },
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Authority Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Operation Id",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "allocation_id",
        "authority_id",
        "operation_id",
        "plan_sha256"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "BudgetAuthority": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Authority Id",
          "type": "string"
        },
        "cap_usd": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Cap Usd",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "max_outbound_attempts": {
          "minimum": 0,
          "title": "Max Outbound Attempts",
          "type": "integer"
        },
        "run_deadline_utc": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$",
          "title": "Run Deadline Utc",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "authority_id",
        "scope_sha256",
        "cap_usd",
        "max_outbound_attempts",
        "run_deadline_utc"
      ],
      "title": "BudgetAuthority",
      "type": "object"
    },
    "CallContext": {
