        "source_generation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Generation",
          "type": "string"
        },
        "transform_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transform Sha256",
          "type": "string"
