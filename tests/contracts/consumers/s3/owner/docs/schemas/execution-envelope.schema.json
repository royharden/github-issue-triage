          ],
          "default": null,
          "title": "Max Total Input Tokens"
        },
        "max_total_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Output Tokens"
        },
        "operation_deadline_s": {
          "exclusiveMinimum": 0,
          "title": "Operation Deadline S",
          "type": "number"
        },
        "run_deadline_utc": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$",
          "title": "Run Deadline Utc",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "max_attempts_total",
        "max_content_repairs",
        "operation_deadline_s",
        "attempt_timeout_s",
        "run_deadline_utc",
        "max_outbound_attempts",
        "max_concurrent_operations",
        "max_request_bytes",
        "max_response_bytes",
        "max_questions",
        "max_choice_options"
      ],
      "title": "Limits",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "local_image": "#/$defs/ImagePart",
                "text": "#/$defs/TextPart"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextPart"
              },
              {
                "$ref": "#/$defs/ImagePart"
              }
            ]
          },
          "minItems": 1,
          "title": "Content",
          "type": "array"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
