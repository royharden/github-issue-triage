        "max_attempts_total": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts Total",
          "type": "integer"
        },
        "max_choice_options": {
          "maximum": 255,
          "minimum": 1,
          "title": "Max Choice Options",
          "type": "integer"
        },
        "max_concurrent_operations": {
          "exclusiveMinimum": 0,
          "title": "Max Concurrent Operations",
          "type": "integer"
        },
        "max_content_repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Content Repairs",
          "type": "integer"
        },
        "max_outbound_attempts": {
          "minimum": 0,
          "title": "Max Outbound Attempts",
          "type": "integer"
