    "ChoiceSpec": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              },
              {
                "items": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 255,
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 255,
            "minLength": 1
          },
          "title": "Criteria",
          "type": "object"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            }
          ],
          "title": "Instructions"
