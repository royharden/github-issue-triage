  "additionalProperties": false,
  "description": "Required public accounting binding; does not dispatch or admit an operation.",
  "properties": {
    "allocation": {
      "$ref": "#/$defs/Allocation"
    },
    "budget": {
      "$ref": "#/$defs/BudgetAuthority"
    },
    "capture_mode": {
      "enum": [
        "disabled",
        "fixture_replay",
        "consumer_store"
      ],
      "title": "Capture Mode",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CallContext"
    },
    "ledger_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
