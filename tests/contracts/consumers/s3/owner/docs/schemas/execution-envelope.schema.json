          "enum": [
            "low",
            "high",
            "auto"
          ],
          "title": "Detail",
          "type": "string"
        },
        "execution_ref": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Execution Ref",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
